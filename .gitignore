/target

# Rust build lockfile — this crate is a library, so we do
# not commit Cargo.lock. See https://doc.rust-lang.org/cargo/faq.html#why-do-binaries-have-cargolock-in-version-control-but-not-libraries
Cargo.lock

# cargo-fuzz writes a per-target corpus under fuzz/corpus/ on every run;
# these are generated artifacts, not source — EXCEPT the committed
# regression seeds under fuzz/corpus/<target>/seeds/, which must not be
# both tracked and ignored (release-plz refuses a working tree with
# tracked-and-ignored files).
/fuzz/corpus/*/*
!/fuzz/corpus/*/seeds/

# cargo-fuzz writes crash / OOM / slow-unit reproducers under
# fuzz/artifacts/ — generated, not source.
/fuzz/artifacts/
